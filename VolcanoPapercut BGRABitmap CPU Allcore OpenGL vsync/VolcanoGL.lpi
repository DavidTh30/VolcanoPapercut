<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Volcano Papercut GL"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Release" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LazOpenGLContext"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="VolcanoGL.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="urenderpool.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uRenderPool"/>
      </Unit>
      <Unit>
        <Filename Value="uvolcanoscene.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uVolcanoScene"/>
      </Unit>
      <Unit>
        <Filename Value="uframerenderer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uFrameRenderer"/>
      </Unit>
      <Unit>
        <Filename Value="umainform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uMainForm"/>
      </Unit>
      <Unit>
        <Filename Value="umfvideo.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uMFVideo"/>
      </Unit>
      <Unit>
        <Filename Value="uexportjob.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uExportJob"/>
      </Unit>
      <Unit>
        <Filename Value="uinfoform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uInfoForm"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="VolcanoGL"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="False"/>
        <RunWithoutDebug Value="True"/>
      </Debugging>
      <LinkSmart Value="True"/>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
